<!--
Atom entry with a media:thumbnail. Verifies the thumbnail url is extracted as an
image media link.

@ len(feed.Items[0].MediaLinks) == 1
@ feed.Items[0].MediaLinks[0].URL == "https://example.com/image.png?width=100&height=100"
@ feed.Items[0].MediaLinks[0].Type == "image"
-->
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
	<entry>
		<media:thumbnail url="https://example.com/image.png?width=100&height=100" />
	</entry>
</feed>
