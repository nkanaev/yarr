{
  "type": "module",
  "scripts": {
    "build": "esbuild src/frontend/js/main.tsx src/frontend/css/app.css --bundle --outdir=src/assets/static --entry-names=bundle --jsx=automatic --jsx-import-source=preact --supported:nesting=false --target=es2020 --sourcemap",
    "typecheck": "tsc --noEmit"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "singleQuote": false,
    "trailingComma": "all",
    "semi": true,
    "arrowParens": "avoid",
    "htmlWhitespaceSensitivity": "css",
    "bracketSameLine": true
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@fluent/bundle": "^0.19.1",
    "@preact/signals": "^2.11.3",
    "bootstrap": "^5.3.8",
    "lucide": "^1.47.0",
    "preact": "^11.0.0"
  }
}
