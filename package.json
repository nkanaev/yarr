{
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "typecheck": "vue-tsc --noEmit"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "singleQuote": false,
    "trailingComma": "all",
    "semi": true,
    "arrowParens": "avoid",
    "htmlWhitespaceSensitivity": "css",
    "bracketSameLine": true
  },
  "devDependencies": {
    "@vue/typescript-plugin": "^3.3.7",
    "esbuild": "0.28.1",
    "esbuild-plugin-vue3": "^0.5.1",
    "typescript": "^5.7.0",
    "vue-tsc": "^3.3.7"
  },
  "dependencies": {
    "@fluent/bundle": "^0.19.1",
    "bootstrap": "^5.3.8",
    "vue": "^3.5.13"
  }
}
